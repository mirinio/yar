<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>yar</AssemblyName>
    <RootNamespace>Yar.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Composition/Yar.Hosting/Yar.Hosting.csproj" />
  </ItemGroup>
  <!-- Yar's own logo, laid out as an icon theme folder so GTK finds it by the app's ID even when Yar is not installed. -->
  <ItemGroup>
    <Content Include="../../../assets/cube_logo.svg" Link="icons/hicolor/scalable/apps/io.github.mirinio.Yar.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="GirCore.Adw-1" />
    <PackageReference Include="GirCore.Gtk-4.0" />
    <PackageReference Include="NGettext" />
  </ItemGroup>
</Project>
